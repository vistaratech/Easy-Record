{
  "version": 2,
  "builds": [
    { "src": "web/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "server/index.js", "use": "@vercel/node" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server/index.js" },
    { "source": "/(.*)\\.(.+)", "destination": "/web/$1.$2" },
    { "source": "/(.*)", "destination": "/web/index.html" }
  ]
}
