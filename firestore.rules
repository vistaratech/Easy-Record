rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own user profile. Admins can read and write all.
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // For registers and other collections, allow if authenticated for now.
    // (A more robust role-based system would require validating the user's businessId)
    match /registers/{registerId} {
      allow read, write: if request.auth != null;
      
      // Also allow subcollections like entries_chunks
      match /entries_chunks/{chunkId} {
      	allow read, write: if request.auth != null;
      }
    }
    
    match /businesses/{businessId} {
    	allow read, write: if request.auth != null;
    }
    
    match /folders/{folderId} {
    	allow read, write: if request.auth != null;
    }
  }
}
